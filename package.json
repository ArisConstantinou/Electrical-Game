{
  "name": "wire-the-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5362 --strictPort",
    "studio:webgame": "vite --host 127.0.0.1 --port 5362 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5363 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test:demolition-logic": "node tests/demolition-progression-smoke.mjs",
    "test:gameplay": "node tests/gameplay-smoke.mjs",
    "test:studio": "node tests/studio-contract.mjs",
    "test:studio-live": "node tests/studio-live-smoke.mjs",
    "test:masonry": "node tests/masonry-acceptance.mjs",
    "test:masonry-contact": "node tests/masonry-contact.mjs",
    "test:masonry-benchmark": "node tests/masonry-benchmark.mjs",
    "test:hammer-stance": "node tests/hammer-stance-smoke.mjs",
    "test:mortar": "node tests/mortar-application-smoke.mjs",
    "test:mortar-stacking": "node tests/mortar-volume-regression.mjs && node tests/mortar-stacking-ui.mjs",
    "test:box-placement": "node tests/hand-work-stance.mjs && node tests/box-placement-ui.mjs",
    "test:default-flood": "node tests/default-flood-ui.mjs",
    "test:tools-visual": "node tests/tools-visual-smoke.mjs",
    "test:room-water-field": "node tests/room-water-field.mjs",
    "test:room-water": "node tests/room-water-smoke.mjs",
    "test:room-water-performance": "node tests/room-water-performance.mjs",
    "test:chisel-balanced": "node tests/chisel-balanced-ui.mjs",
    "test:hammer-eyes": "node tests/hammer-eye-input.mjs && node tests/hammer-eye-look-ui.mjs && node tests/renderer-eye-snapshot.mjs",
    "test:tool-view": "node tests/hammer-eye-input.mjs && node tests/shared-tool-view-ui.mjs",
    "test:tool-contact": "node tests/tool-poses-contact.mjs",
    "test:continuous-chase": "node tests/chase-feed-input.mjs && node tests/masonry-fragment-size.mjs && node tests/continuous-chase-ui.mjs",
    "test:angled-fracture": "node tests/angled-fracture.mjs && node tests/angled-fracture-ui.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "playwright": "^1.55.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
